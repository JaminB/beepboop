# /srv/beepboop/deploy/caddy/Caddyfile
# Canonical shape: docs/OPERATIONS.md §4 (Tier 0, local CA). Tier 1 (v0.2) swaps
# `tls internal` for ACME (ADR 0013). Routes:
#   :443   everything -> core (127.0.0.1:8080), except HA's OAuth callback path
#   :80    /ca helper (plain HTTP, read-only) and a redirect to HTTPS
#   :8443  Home Assistant UI, admin-gated (break-glass)
#   :8445  Music Assistant UI, admin-gated (only useful with the `music` profile)
{
	pki {
		ca local {
			root {
				# Generated by install.sh with X.509 nameConstraints (BB_HOST, .local,
				# RFC 1918, ULA); the key never leaves Caddy's /data volume.
				cert /data/caddy/pki/authorities/local/root.crt
				key /data/caddy/pki/authorities/local/root.key
			}
		}
	}
	# Tier 1 (v0.2) with your own domain:  acme_dns <provider> {$DNS_API_TOKEN}; with Tailscale, nothing to add.
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	encode zstd gzip
}

(admin_gate) {
	# Only a beepboop admin web session passes (200); anything else gets core's 401.
	forward_auth 127.0.0.1:8080 {
		uri /api/auth/check?require=admin
		copy_headers X-BB-Profile
	}
}

{$BB_HOST} {
	import hardening
	tls internal # Tier 0 only

	# HA OAuth flows bounce here via my.home-assistant.io; HA validates its signed state.
	# This is the ONLY HA path exposed without the admin gate.
	@ha_callback path /auth/external/callback*
	handle @ha_callback {
		reverse_proxy 127.0.0.1:8123
	}
	handle {
		reverse_proxy 127.0.0.1:8080 # SPA, /api, /confirm; /mcp and /oauth in v0.2
	}
}

http://{$BB_HOST} {
	handle /ca* {
		reverse_proxy 127.0.0.1:8080 # "install the beepboop CA" helper, deliberately plain HTTP, read-only
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# Home Assistant's own UI as break-glass; logged as an admin action.
{$BB_HOST}:8443 {
	import hardening
	tls internal
	import admin_gate
	reverse_proxy 127.0.0.1:8123 {
		header_up -Cookie # the beepboop session cookie never reaches HA
	}
}

# Music Assistant's UI, only when the `music` profile is on.
{$BB_HOST}:8445 {
	import hardening
	tls internal
	import admin_gate
	reverse_proxy 127.0.0.1:8095 {
		header_up -Cookie
	}
}
