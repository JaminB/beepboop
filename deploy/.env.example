# deploy/.env.example -> copy to /srv/beepboop/deploy/.env (install.sh writes it).
#
# Holds host, tier, locale, the RAM profile's memory caps and image digests ONLY
# (docs/OPERATIONS.md §3). NEVER put a secret, token, password or PIN here:
# credentials live envelope-encrypted in SQLite.

# ---- host / tier / locale ----------------------------------------------------
BB_HOST=beepboop.local
BB_TIER=0
BB_LOCALE=en-US

# ---- RAM profile: memory caps (docs/OPERATIONS.md §7) ------------------------
# 4 GB Pi (default). For an 8 GB Pi use: CORE=1g AUDIO=1g HA=2g MUSIC=768m.
BB_MEM_CADDY=64m
BB_MEM_CORE=768m
BB_MEM_AUDIO=768m
BB_MEM_HA=1g
BB_MEM_MUSIC=512m

# ---- image digests -----------------------------------------------------------
# Format: sha256:<64 hex>. Empty values make `docker compose` refuse to start, on
# purpose: nothing runs from a floating tag. A release pins all of these together.
# Look one up with:  docker buildx imagetools inspect <image>:<tag>
BB_CADDY_DIGEST=
BB_CORE_DIGEST=
BB_AUDIO_DIGEST=
# Home Assistant: record the vetted tag next to the digest, e.g. 2026.10.3
BB_HA_DIGEST=
BB_MUSIC_DIGEST=
