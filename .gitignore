# Bench corpus is recorded on the owner's bench machine (never on a beepboop device, ADR 0018) and never committed (results/ is)
tools/bench/corpus/

# Probe scratch data (keys + secrets DB written by the V2/V5 probes)
v2-data/
v5-data/

